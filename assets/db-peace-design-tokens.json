{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "DB Peace AI — Design-Tokens im Erscheinungsbild der Deutschen Bahn. Drei Ebenen: Primitive, Semantisch, Komponente. Die Farbwerte stammen aus dem bestehenden Projekt (tailwind.config.js) und sind dort seit Beginn hinterlegt.",
  "primitive": {
    "color": {
      "red": {
        "500": { "$value": "#E2001A", "$type": "color", "$description": "DB Rot — Flächen und Text ab 18px" },
        "700": { "$value": "#A40013", "$type": "color", "$description": "abgedunkelt für kleinen Text auf hellem Grund" },
        "300": { "$value": "#FF7A84", "$type": "color", "$description": "aufgehellt für Text auf dunklem Grund" }
      },
      "gray": {
        "900": { "$value": "#282D37", "$type": "color", "$description": "DB Cool Gray Dark" },
        "700": { "$value": "#3D4552", "$type": "color" },
        "500": { "$value": "#646973", "$type": "color", "$description": "DB Cool Gray Mid" },
        "200": { "$value": "#ECEEF1", "$type": "color", "$description": "DB Secondary Background" },
        "100": { "$value": "#F0F3F5", "$type": "color", "$description": "DB Cool Gray Light" }
      },
      "night": { "$value": "#1F242C", "$type": "color", "$description": "dunkler als Cool Gray Dark, damit Karten im Dunkelmodus tragen" },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "font": {
      "sans": {
        "$value": "Fira Sans",
        "$type": "fontFamily",
        "$description": "Steht DB Type am nächsten — dieselbe Werkstatt (Spiekermann), humanistische Grotesk, klare Ziffern. Bewusst nicht Inter."
      }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight", "$description": "schwerstes Gewicht — 900 wirkt im DB-Bild überzogen" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm": { "$value": "2px", "$type": "dimension" },
      "md": { "$value": "3px", "$type": "dimension" },
      "lg": { "$value": "4px", "$type": "dimension", "$description": "Obergrenze — das DB-Bild lebt von Kanten, nicht von Kacheln" }
    },
    "shadow": {
      "flat": { "$value": "0 1px 2px rgba(40, 45, 55, 0.10)", "$type": "shadow" }
    }
  },
  "semantic": {
    "color": {
      "ground": { "$value": "{primitive.color.gray.100}", "$type": "color", "$description": "Seitenhintergrund" },
      "surface": { "$value": "{primitive.color.white}", "$type": "color", "$description": "Karten und Dialoge" },
      "surface-sunk": { "$value": "{primitive.color.gray.100}", "$type": "color", "$description": "eingelassene Flächen in Karten" },
      "surface-inverse": { "$value": "{primitive.color.gray.900}", "$type": "color", "$description": "abgesetzte Kopfbereiche" },
      "ink": { "$value": "{primitive.color.gray.900}", "$type": "color", "$description": "Überschriften und Fließtext" },
      "ink-muted": { "$value": "{primitive.color.gray.500}", "$type": "color", "$description": "Nebentext" },
      "ink-inverse": { "$value": "{primitive.color.white}", "$type": "color" },
      "line": { "$value": "{primitive.color.gray.900}", "$type": "color", "$description": "Kanten, immer mit Alpha" },
      "accent": { "$value": "{primitive.color.red.500}", "$type": "color", "$description": "trägt allein den Akzent" },
      "accent-ink": { "$value": "{primitive.color.red.700}", "$type": "color" }
    }
  },
  "semanticDark": {
    "color": {
      "ground": { "$value": "{primitive.color.night}", "$type": "color" },
      "surface": { "$value": "{primitive.color.gray.900}", "$type": "color", "$description": "heller als der Grund, sonst sind Karten unsichtbar" },
      "surface-sunk": { "$value": "{primitive.color.gray.700}", "$type": "color" },
      "surface-inverse": { "$value": "{primitive.color.gray.700}", "$type": "color" },
      "ink": { "$value": "{primitive.color.white}", "$type": "color" },
      "ink-muted": { "$value": "#9BA3AE", "$type": "color" },
      "line": { "$value": "{primitive.color.white}", "$type": "color" },
      "accent-ink": { "$value": "{primitive.color.red.300}", "$type": "color" }
    }
  },
  "component": {
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.line}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.none}", "$type": "dimension" }
    },
    "button-primary": {
      "bg": { "$value": "{semantic.color.accent}", "$type": "color" },
      "ink": { "$value": "{primitive.color.white}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" }
    },
    "header": {
      "bg": { "$value": "{semantic.color.surface-inverse}", "$type": "color" },
      "ink": { "$value": "{semantic.color.ink-inverse}", "$type": "color" },
      "accentBar": { "$value": "{semantic.color.accent}", "$type": "color", "$description": "roter Balken unter der Überschrift — das Strukturelement der App" }
    }
  }
}
